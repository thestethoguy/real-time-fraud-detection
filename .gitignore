# ── Large Data Files (never commit Kaggle CSVs) ──────────────────────────────
data/
*.csv

# ── Model Artifacts (too large for Git; use DVC or Git LFS instead) ──────────
*.pkl
*.joblib

# ── Archives ──────────────────────────────────────────────────────────────────
*.zip
*.tar.gz
*.tar

# ── Python Cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Jupyter Artifacts ─────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Virtual Environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
.env/
ENV/

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ── Streamlit secrets ─────────────────────────────────────────────────────────
.streamlit/secrets.toml

# ── Logs & temp ───────────────────────────────────────────────────────────────
*.log
*.tmp
outputs/*.png

# ── Dashboard assets — explicit exceptions (MUST be at the bottom) ──────────────
# The ! prefix negates the *.pkl and *.csv wildcard rules above,
# ensuring Streamlit Cloud always has the model and sample data.
!dashboard/model.pkl
!dashboard/sample_transactions.csv
